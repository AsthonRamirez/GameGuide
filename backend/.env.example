# Copia este archivo como .env y completa tus claves.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- Proveedor de IA ----------------
# gemini (por defecto) u openai (cualquier API compatible con OpenAI: Mistral, Groq, OpenRouter, Ollama...)
LLM_PROVIDER=gemini
# Verifica en https://aistudio.google.com que estos modelos existan para tu llave;
# al arrancar, el backend avisa en el log si alguno no está disponible.
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_BACKUP_MODEL=gemini-3.8-flash

# Ejemplo para comparar con Mistral (LLM_PROVIDER=openai):
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=
# LLM_MODEL=mistral-small-latest
# LLM_BACKUP_MODEL=
# Ejemplo Groq: LLM_BASE_URL=https://api.groq.com/openai/v1

LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=2048
USE_LLM_INTENT=1

# ---------------- Recuperación ----------------
CACHE_TTL_DAYS=14
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CONTEXT_CHUNKS=6
SEMANTIC_MIN_SIMILARITY=0.30

# ---------------- Reutilización de respuestas ----------------
REUSE_ENABLED=1
REUSE_THRESHOLD=0.93

# ---------------- Seguridad ----------------
# Uno o varios orígenes separados por coma (en producción, SOLO el dominio de tu frontend).
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_CHAT_PER_MIN=8
RATE_LIMIT_VOTE_PER_MIN=30
# Pon 1 solo si hay un proxy de confianza delante (Render, Nginx...) que envíe X-Forwarded-For.
TRUST_PROXY_HEADERS=0
